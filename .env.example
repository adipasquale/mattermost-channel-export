# Mattermost instance URL
MM_URL=https://mattermost.example.com

# Personal access token (from Account Settings → Security → Personal Access Tokens)
MM_TOKEN=your-personal-access-token

# ID of the channel(s) to export. Comma-separated for multiple channels, e.g. `abc123,def456`
MM_CHANNEL_ID="abc123def456"

# Cookie header to send with every request, needed when the instance sits behind an auth proxy (see below)
# Optional: only needed behind an oauth2-proxy
MM_COOKIE="_oauth2_proxy=XXXX"

# Directory where the output files are written
MM_OUTPUT_DIR="exports"
